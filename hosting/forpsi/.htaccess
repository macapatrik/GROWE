# Merge with existing rules if preserving WordPress or other subpages.
DirectoryIndex index.html index.php
Options -Indexes
ErrorDocument 404 /404.html
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^tym/?$ https://www.growe.cz/#tym [R=301,L,NE]
# Canonical production host. Install only once TLS is active for both names.
RewriteCond %{HTTP_HOST} ^growe\.cz$ [NC]
RewriteRule ^ https://www.growe.cz%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^www\.growe\.cz$ [NC]
RewriteRule ^ https://www.growe.cz%{REQUEST_URI} [R=301,L,NE]
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
<FilesMatch "\.(html|xml|txt)$">
Header set Cache-Control "no-cache"
</FilesMatch>
<FilesMatch "\.(webp|png|jpg|svg|woff2?)$">
Header set Cache-Control "public, max-age=86400"
</FilesMatch>
<FilesMatch "^(index|main)-[A-Za-z0-9_-]+\.(css|js)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml application/xml
</IfModule>
